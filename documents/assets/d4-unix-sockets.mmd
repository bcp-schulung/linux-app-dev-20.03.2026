    C3 --> C5["listen(fd, backlog)"]
    C5 --> C6["accept(fd, ...)"]
    
    D[Client] --> D1["socket(AF_UNIX, SOCK_STREAM, 0)"]
    D1 --> D2["connect(fd, addr, len)"]
    
    E[Datagram] --> E1[SOCK_DGRAM]
    E1 --> E2[Unreliable no connection]
    E1 --> E3[Message boundaries]
    
    F[Stream] --> F1[SOCK_STREAM]
    F1 --> F2[Reliable connection-based]
    F1 --> F3[Byte stream]
    
    G[Advantages] --> G1[Faster than TCP]
    G --> G2[File permissions for access control]
    G --> G3[Pass file descriptors!]
    

graph LR
    A[Unix Domain Sockets] --> B[Fast local IPC]
    A --> C[Socket API familiar]
    
    B --> B1["socketpair(AF_UNIX, SOCK_STREAM, 0, sv)"]
    B1 --> B2["sv[0] and sv[1] connected"]
    B2 --> B3[Bidirectional]
    
    C --> C1["socket(AF_UNIX, SOCK_STREAM, 0)"]
    C1 --> C2["bind(fd, addr, len)"]

graph TB
    subgraph "Process Memory Space - Shared"
        A[Code Text Segment]
        B[Data Segment .data .bss]
        C[Heap malloc shared]
        D[Open File Descriptors]
        E[Signal Handlers]
        F[Working Directory]
    end
    
    subgraph "Thread 1 - Private"
        T1A[Thread ID TID]
        T1B[Stack Local Variables]
        T1C[Registers PC SP]
        T1D[errno thread-local]
        T1E[Signal Mask]
    end
    
    subgraph "Thread 2 - Private"
        T2A[Thread ID TID]
        T2B[Stack Local Variables]
        T2C[Registers PC SP]
        T2D[errno thread-local]
        T2E[Signal Mask]
    end
    
    T1A -.Shares.-> C
    T1A -.Shares.-> D
    T2A -.Shares.-> C
    T2A -.Shares.-> D
    
    style C fill:#e8f5e8
    style T1B fill:#e1f5ff
    style T2B fill:#e1f5ff
